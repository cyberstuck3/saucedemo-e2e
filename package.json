{
  "name": "saucedemo-e2e",
  "version": "1.0.0",
  "private": true,
  "description": "UI end-to-end suite for saucedemo.com: page objects, tiered cross-browser runs, and a written bug report.",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:chromium": "playwright test --project=chromium",
    "test:firefox": "playwright test --project=firefox",
    "test:defects": "playwright test tests/05-problem-user-defects.spec.ts",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0"
  }
}
